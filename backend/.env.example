# Copy to backend/.env and add your Groq API key.
# Never commit backend/.env or expose this key in the frontend.
GROQ_API_KEY=your_groq_api_key_here
# Search model: keep this on the 20B model. Search implementation is separate.
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# Deep scientific analysis model: explanations, comparisons, chatbot, safety and uploads.
GROQ_DEEP_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_ANALYSIS_REASONING_EFFORT=medium

# Comma-separated browser origins allowed to call the API (include your deployed frontend URL).
FIRELYTICS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional: configure only after confirming the official PSI file-download
# route in the browser's Network panel. Supported placeholders:
# {id}, {key}, {study_id}, {filename}. Leave blank until verified.
PSI_DOWNLOAD_URL_TEMPLATE=

# Temporary investigation workspace controls (not permanent file storage)
FIRELYTICS_SESSION_DIR=
FIRELYTICS_SESSION_TTL_SECONDS=7200
FIRELYTICS_MAX_FILE_MB=512
FIRELYTICS_MAX_SESSION_MB=2048
FIRELYTICS_MAX_EXTRACTED_CHARS=50000
FIRELYTICS_ON_DEMAND_MAX_FILE_MB=512
